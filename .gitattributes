* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Files run inside the Linux container must keep LF line endings, even when cloned on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
docker/* text eol=lf
