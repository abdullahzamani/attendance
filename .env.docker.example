# Settings for the Docker deployment. Copy to .env.docker and adjust.

APP_NAME="Staff Movement System"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur

# The address people type to reach the app: this server's IP (or name) and port 8080.
APP_URL=http://192.168.1.50:8080

# Leave empty: a key and a board token are generated on first start and kept in the data volume.
APP_KEY=
BOARD_TOKEN=

# First administrator, created only on the very first start. Change the password after logging in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=sync

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
